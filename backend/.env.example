# Copy the values into the backend process environment before running Spring Boot.
# Spring Boot does not load this file automatically; the Python engine reads backend/.env.
DB_URL=jdbc:postgresql://localhost:5432/flowforge
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
ENGINE_API_TOKEN=replace-with-a-long-random-shared-token
SESSION_COOKIE_SECURE=true
