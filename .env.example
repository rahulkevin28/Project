# Copy to .env and provide credentials for the selected provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=
# To use Claude, change LLM_PROVIDER to anthropic, set
# LLM_MODEL=claude-haiku-4-5-20251001, and add your Anthropic Console key below.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Google Gemini example: LLM_PROVIDER=google, LLM_MODEL=gemini-3.8-flash
LOG_LEVEL=INFO

# Optional shared secret. When set, every API call except /health and the console page
# must send "Authorization: Bearer <token>". Set it anywhere other than your own machine.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_TOKEN=

# Limits and retries (defaults shown). Only timeouts, rate limits, and provider outages
# are retried; bad keys and rejected requests fail straight away.
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=30
RUN_TIMEOUT_SECONDS=300

# Optional cost estimates: US dollars per million tokens for each model ID you use.
# Check your provider's current price list; these numbers are only an example.
# MODEL_PRICES={"claude-haiku-4-5-20251001": {"input_per_million": 1.0, "output_per_million": 5.0}}
